---
const base = import.meta.env.BASE_URL;
const nav = [
  { href: base, label: '首页' },
  { href: `${base}lessons/`, label: '全部关卡' },
  { href: `${base}about/`, label: '关于' },
];
const { title = 'Shell Lab', description = '浏览器里的 Linux 命令练习场：分关卡练文件、文本与权限，纯前端模拟终端。' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-canvas text-ink antialiased">
    <header class="border-b border-line">
      <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
        <a href={base} class="font-semibold tracking-tight">Shell Lab</a>
        <nav class="flex items-center gap-4 text-[13px] text-muted">
          {nav.map((item) => <a href={item.href} class="transition-colors hover:text-ink">{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl border-t border-line px-4 py-6 text-[11px] text-muted sm:px-6">
      纯前端模拟终端，不连接真实系统 · <a href="https://everwynn.github.io/" class="hover:text-ink">返回门户</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --canvas: 250 250 249;
    --surface: 255 255 255;
    --line: 228 228 231;
    --ink: 24 24 27;
    --muted: 113 113 122;
    --ok: 22 163 74;
    --warn: 217 119 6;
    --danger: 220 38 38;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --canvas: 9 9 11;
      --surface: 24 24 27;
      --line: 39 39 42;
      --ink: 244 244 245;
      --muted: 161 161 170;
      --ok: 74 222 128;
      --warn: 251 191 36;
      --danger: 248 113 113;
    }
  }
</style>
